#!/usr/bin/env node
// Concatenates src/ into dist/helix-design.css (font, tokens, components) and the opt-in
// element base dist/helix-base.css. Plain node, no dependencies.
// Deterministic: fixed order, no timestamps, exactly one trailing newline.
// Cascade layers are added here, not in src/: src/tokens.css is shared with the report theme,
// which must stay unlayered (scripts/build-report-theme).
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const ROOT = path.resolve(__dirname, '..');

const LAYER_ORDER = '@layer helix.tokens, helix.base, helix.components;';

// Order matters: font, tokens, then components (generic before specific).
// @font-face stays outside the layers; every other file goes into the layer named here.
const LAYER_OF = {
  'src/fonts.css': null,
  'src/tokens.css': 'helix.tokens',
};
const ORDER = [
  'src/fonts.css',
  'src/tokens.css',
  'src/components/typography.css',
  'src/components/focus.css',
  'src/components/buttons.css',
  'src/components/stepper.css',
  'src/components/inputs.css',
  'src/components/chips.css',
  'src/components/cards.css',
  'src/components/list-rows.css',
  'src/components/nav.css',
  'src/components/fab.css',
  'src/components/sheet.css',
  'src/components/toast.css',
  'src/components/states.css',
  'src/components/progress.css',
];

// The opt-in element base (html, body, headings, links, global focus ring, reduced motion).
const BASE_ORDER = ['src/base.css'];

const version = () => JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8')).version;
const source = (file) => `/* ===== ${file} ===== */\n${fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/\s+$/, '')}\n`;
const indent = (css) => css.replace(/^(?=.)/gm, '  ');

// Wraps consecutive files of the same layer into one `@layer name { ... }` block.
function layered(files, layerOf) {
  const groups = [];
  for (const file of files) {
    const layer = layerOf(file);
    const last = groups[groups.length - 1];
    if (last && last.layer === layer) last.files.push(file);
    else groups.push({ layer, files: [file] });
  }
  return groups.map(({ layer, files: group }) => {
    const css = group.map(source).join('\n');
    return layer ? `@layer ${layer} {\n${indent(css)}}\n` : css;
  });
}

function build() {
  const header =
    `/*! helix-design v${version()} | MIT (fonts OFL-1.1) | Pantheon visual language: tokens + components.\n` +
    '    Generated by scripts/build from src/; do not edit by hand.\n' +
    '    No global element styles; the opt-in element base is helix-base.css (layer helix.base). */\n';
  const layerOf = (file) => (file in LAYER_OF ? LAYER_OF[file] : 'helix.components');
  return `${header}${LAYER_ORDER}\n\n${layered(ORDER, layerOf).join('\n')}`;
}

function buildBase() {
  const header =
    `/*! helix-design v${version()} | MIT | opt-in element base for helix-design.css.\n` +
    '    Generated by scripts/build from src/base.css; do not edit by hand. */\n';
  return `${header}${LAYER_ORDER}\n\n${layered(BASE_ORDER, () => 'helix.base').join('\n')}`;
}

if (require.main === module) {
  for (const [name, css] of [['helix-design.css', build()], ['helix-base.css', buildBase()]]) {
    const out = path.join(ROOT, 'dist', name);
    fs.mkdirSync(path.dirname(out), { recursive: true });
    fs.writeFileSync(out, css);
    console.log(`wrote ${path.relative(ROOT, out)}`);
  }
}

module.exports = { build, buildBase, ORDER, BASE_ORDER, LAYER_ORDER };
