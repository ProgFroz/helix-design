{
  "name": "helix-design",
  "version": "0.1.0",
  "description": "Pantheon visual language for the Helix umbrella: design tokens and framework-agnostic CSS components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgFroz/helix-design.git"
  },
  "style": "./dist/helix-design.css",
  "exports": {
    ".": "./dist/helix-design.css",
    "./css": "./dist/helix-design.css",
    "./base.css": "./dist/helix-base.css",
    "./tokens.css": "./src/tokens.css",
    "./switcher.js": "./src/switcher.js",
    "./report.css": "./dist/pantheon-report.css",
    "./dist/*": "./dist/*",
    "./fonts/*": "./dist/fonts/*",
    "./fonts/OFL.txt": "./dist/fonts/OFL.txt",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "demo",
    "README.md",
    "TOKENS.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./src/switcher.js"
  ],
  "scripts": {
    "test": "node scripts/check.js",
    "build": "node scripts/build && node scripts/build-report-theme",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/html-vite": "^10.6.2",
    "storybook": "^10.6.2",
    "vite": "^8.3.4"
  }
}
