#!/usr/bin/env node
// Concatenates src/ into dist/helix-design.css. Plain node, no dependencies.
// Deterministic: fixed order, no timestamps, exactly one trailing newline.
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const ROOT = path.resolve(__dirname, '..');

// Order matters: font, tokens, base, then components (generic before specific).
const ORDER = [
  'src/fonts.css',
  'src/tokens.css',
  'src/base.css',
  'src/components/typography.css',
  'src/components/focus.css',
  'src/components/buttons.css',
  'src/components/stepper.css',
  'src/components/inputs.css',
  'src/components/chips.css',
  'src/components/cards.css',
  'src/components/list-rows.css',
  'src/components/nav.css',
  'src/components/fab.css',
  'src/components/sheet.css',
  'src/components/toast.css',
  'src/components/states.css',
  'src/components/progress.css',
];

function build() {
  const { version } = JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8'));
  const header =
    `/*! helix-design v${version} | MIT | Pantheon visual language: tokens + components.\n` +
    '    Generated by scripts/build from src/; do not edit by hand. */\n';
  const parts = ORDER.map((file) => {
    const css = fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/\s+$/, '');
    return `/* ===== ${file} ===== */\n${css}\n`;
  });
  return `${header}\n${parts.join('\n')}`;
}

if (require.main === module) {
  const out = path.join(ROOT, 'dist', 'helix-design.css');
  fs.mkdirSync(path.dirname(out), { recursive: true });
  fs.writeFileSync(out, build());
  console.log(`wrote ${path.relative(ROOT, out)}`);
}

module.exports = { build, ORDER };
